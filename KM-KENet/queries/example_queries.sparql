# Example SPARQL queries over outputs/knowledge_graph/knowledge_graph.ttl
# (load the file into any triple store, e.g. Apache Jena Fuseki or GraphDB,
#  or run `python -m step5_knowledge_graph.sparql` which uses rdflib).

PREFIX kmkg: <https://github.com/shkomq/SciKG-LLM/kmkg#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

# --- Q1. Drugs that treat diabetes, with their Kurdish names -----------------
SELECT ?drug ?drug_ckb ?drug_en WHERE {
  ?disease rdfs:label "diabetes"@en .
  ?drug kmkg:TREATS ?disease ;
        a kmkg:Drug ;
        rdfs:label ?drug_ckb .
  FILTER(lang(?drug_ckb) = "ckb")
  OPTIONAL { ?drug rdfs:label ?drug_en FILTER(lang(?drug_en) = "en") }
}

